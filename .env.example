# Copie este arquivo para .env na raiz do projeto.

DJANGO_SECRET_KEY=troque-esta-chave-antes-de-publicar
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# E-mail. No desenvolvimento o padrão é imprimir a mensagem no console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=biblioteca@acervo.local

# Frontend (opcional). Se omitido, o Vite usa http://127.0.0.1:8000/api
# Coloque esta linha em frontend/.env se quiser sobrescrever.
# VITE_API_URL=http://127.0.0.1:8000/api

# PostgreSQL. Quando POSTGRES_DB estiver definido, o SQLite deixa de ser usado.
# POSTGRES_DB=acervo
# POSTGRES_USER=acervo
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
